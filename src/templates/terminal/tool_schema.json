            "default": 30,
            "minimum": 1
          },
          "lines": {
            "type": "integer",
            "description": "Maximum output lines to return.",
            "default": 200,
            "minimum": 1
          },
          "mode": {
            "type": "string",
            "description": "Slice mode when still running.",
            "enum": [
              "head",
              "tail",
              "startwith"
            ],
            "default": "tail"
          },
          "startwith": {
            "type": "integer",
            "description": "When mode=startwith, start from this line number (1-based).",
            "default": 1,
            "minimum": 1
          }
        },
        "required": [
          "run_id"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "terminal_checkout",
      "description": "Peek current output and status by run_id without waiting.",
      "parameters": {
        "type": "object",
        "properties": {
          "run_id": {
            "type": "string",
            "description": "ID returned by terminal_exec."
          },
