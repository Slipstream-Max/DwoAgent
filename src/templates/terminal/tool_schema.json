            "additionalProperties": {
              "type": "string"
            }
          },
          "timeout": {
            "type": "integer",
            "description": "How many seconds to wait before returning.",
            "default": 30,
            "minimum": 1
          }
        },
        "required": [
          "command"
        ],
        "additionalProperties": false
      }
    }
  },
  {
