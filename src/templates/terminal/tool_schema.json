[
  {
    "type": "function",
    "function": {
      "name": "terminal_exec",
      "description": "Start a terminal command. Wait up to timeout; if it finishes, return final tail output; otherwise return running snapshot and run_id.",
      "parameters": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "description": "Command line to run."
          },
          "env": {
            "type": "object",
            "description": "Optional environment variables.",
            "additionalProperties": {
              "type": "string"
            }
          },
          "timeout": {
            "type": "integer",
            "description": "How many seconds to wait before returning.",
            "default": 30,
            "minimum": 1
          },
          "lines": {
            "type": "integer",
            "description": "Maximum output lines to return.",
            "default": 200,
            "minimum": 1
          },
          "mode": {
            "type": "string",
            "description": "Slice mode when still running.",
            "enum": [
              "head",
              "tail",
              "startwith"
            ],
            "default": "tail"
          },
          "startwith": {
            "type": "integer",
            "description": "When mode=startwith, start from this line number (1-based).",
            "default": 1,
            "minimum": 1
          }
        },
        "required": [
          "command"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
